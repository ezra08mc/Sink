{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sink",
  "main": ".output/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
    "html_handling": "drop-trailing-slash"
  },
  "compatibility_date": "2025-05-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "upload_source_maps": true,
  "observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "sink"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "MASUKKAN_KV_ID_KAMU_DISINI"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sink-db",
      "database_id": "MASUKKAN_D1_DATABASE_ID_KAMU_DISINI",
      "migrations_dir": "drizzle"
    }
  ]
}
